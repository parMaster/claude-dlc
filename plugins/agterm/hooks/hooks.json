{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/approve-overlay.sh"
          }
        ]
      }
    ],
    "Setup": [
      {
        "matcher": "init",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/setup.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/git-info.sh", "timeout": 5 },
          { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/mailbox-chat.py claude-hook", "asyncRewake": true, "rewakeSummary": "chat received", "timeout": 2000000 },
          { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/mailbox-chat.py codex-hook", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/mailbox-chat.py claude-hook", "asyncRewake": true, "rewakeSummary": "chat received", "timeout": 2000000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/git-info.sh", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/git-info.sh", "timeout": 5 },
          { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/mailbox-chat.py claude-hook", "asyncRewake": true, "rewakeSummary": "chat received", "timeout": 2000000 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/git-info.sh", "timeout": 5 }
        ]
      }
    ]
  }
}
